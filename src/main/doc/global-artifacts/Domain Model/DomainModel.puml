@startuml
skinparam style strictuml

' ======================= INFRAESTRUTURA FERROVIÁRIA =======================
package "Infraestrutura Ferroviária" {
  class RailwayNetwork {
    +name : String
  }

  class Owner {
    +ownerId : String
    +name : String
  }

  class Line {
    +lineId : String
    +name : String
    +ownerId: String
  }

  class SegmentType {
    +single
    +double
  }

  class LineSegment {
    +segmentId : String
    +lengthKm : double
    +electrified: boolean
    +gauge_mm : int
    +maxWeightKgPerM : int
    +speedLimitKmH : int
  }

  class NormalStation {
  +stationId : int
  +name : String
  +location : String
  }

  class Terminal {
  +terminalId : int
  +name : String
  }

  class Station {
  +stationType : String
  }
}

' Relações da Infraestrutura
RailwayNetwork -- Line : has
Line *-- LineSegment : has
Line -- Station : pass trough
Line -- Owner : has
LineSegment -- SegmentType : can be
Station -- NormalStation : can be
Station -- Terminal : can be



' ======================= ROLLING STOCK & OPERADORES =======================
package "Rolling Stock & Operadores" {
  class Operator {
    +operatorId : int
    +name : String
  }

  class LocoType {
    +diesel
    +eletric
  }

  class Locomotive {
    +locoId : String
    +make : String
    +model : String
    +serviceYear : int
    +type : LocoType
    +powerKW : double
    +acceleration : double
    +dimensions : String
    +totalWeightKg : int
    +bogies : int
    +fuelCapacityL : int
    +gauge_mm : int
  }

  class WagonType {
    +box
    +flat
    +tank
    +hopper
    +refrig
  }

  class Wagon {
    +wagonId : String
    +type : WagonType
    +payloadKg : int
    +volumeM3 : double
    +tareKg : int
    +dimensions : String
    +gauge_mm : int
  }

  class Train {
    +trainId : String
  }

  class Freight {
    +freightId : String
  }

  class Path {
    +pathId : String
  }

  class PathStep {
    +seq : int
  }

  class Route {
  +routeID : String
  +routeType : String
  }

  class RouteType {
  +complex
  +simple
  }
}

' Relações do Rolling Stock
Operator -- Locomotive : belongs
Operator -- Wagon : belongs
Train -- Locomotive : composed of
Train -- Wagon : composed of

Freight -- Station : transport from A to B
Freight -- Path : carry on
Path *-- PathStep : composed of
PathStep -- Station : has
Wagon -- Freight : carries
Wagon -- WagonType : can be
Locomotive -- LocoType : can be
Freight -- Route : follows
Path -- Route : is part of
Route -- RouteType : can be

' ======================= TERMINAL & WAREHOUSE =======================
package "Terminal & Warehouse" {

  class CirculationLine {
    +id : String
  }

  class ParkingLine {
    +id : String
  }

  class UnloadingDock {
    +id : String
    +code : String
  }

  class Warehouse {
    +warehouseId : String
    +name : String
  }

  class Aisle {
    +aisleNo : int
  }

  class Bay {
  warehouseId : int
    +bayNo : int
    +capacityBoxes : int
    +aisleId : int
  }

  class Item {
    +sku : String
    +name : String
    +category : String
    +unit : String
    +volume : double
    +unitWeight : double
  }

  enum BoxStatus {
    AVAILABLE
    ALLOCATED
    DISPATCHED
    REMOVED
  }

  class Box {
    +boxId : String
    +sku : String
    +quantity : int
    +expiryDate : Date
    +receivedAt : DateTime
    +status : BoxStatus
  }
}

' Relações do Terminal
Terminal -- CirculationLine : has
Terminal -- ParkingLine : has
Terminal -- UnloadingDock : has
Terminal -- Warehouse : connects
Warehouse *-- Aisle : contains
Aisle *-- Bay : contains
Bay -- Box : stores
Item -- Box : describes
Box -- BoxStatus : status
Box -- Wagon : Transport

' ======================= OPERAÇÕES WMS =======================
package "WMS / Movimentos" {
  class ImportBatch {
    +batchId : String
    +sourceFile : String
    +importedAt : DateTime
    +invalidCount : int
    +validCount : int
  }

  enum MovementType {
    UNLOAD
    DISPATCH
    RELOCATE
  }

  class WMSMovement {
    +movementId : String
    +timestamp : DateTime
    +type : MovementType
    +sku : String
    +qty : int
    +fromBay : String
    +toBay : String
    +boxId : String
    +userRole : String
  }

  class UnloadingOperation {
    +opId : String
    +executedAt : DateTime
  }

  class DispatchOperation {
    +opId : String
    +executedAt : DateTime
  }

  class Relocation {
    +opId : String
    +executedAt : DateTime
    +fromBay : String
    +toBay : String
  }
}

' Relações WMS
UnloadingOperation -- Box : creates
DispatchOperation -- Box : consumes)
Relocation -- Box : 1 to many (moves)
WMSMovement --> UnloadingOperation : logs
WMSMovement --> DispatchOperation : logs
WMSMovement --> Relocation : logs

' ======================= PEDIDOS & ALOCAÇÃO =======================
package "Pedidos & Alocação" {
  class Order {
    +orderId : String
    +dueDate : Date
    +priority : int
  }

  class OrderLine {
    +orderId : String
    +lineNo : int
    +sku : String
    +requestedQty : int
  }

  enum AllocationMode {
    STRICT
    PARTIAL
  }

  enum AllocationStatus {
    ELIGIBLE
    PARTIAL
    UNDISPATCHABLE
  }

  class Allocation {
    +allocationId : String
    +orderId : String
    +lineNo : int
    +sku : String
    +qty : int
    +boxId : String
    +aisle : int
    +bay : int
    +mode : AllocationMode
    +status : AllocationStatus
  }
}

' Relações de Pedidos
Order -- OrderLine : 1 to many
Allocation -- OrderLine : 1 to 1 (allocates)
Allocation -- Box : 1 to 1 (from)
Allocation -- Bay : 1 to 1 (at)
Allocation -- AllocationStatus : 1 to 1
Allocation -- AllocationMode : 1 to 1

' ======================= PICKING =======================
package "Picking" {
  class PickingTrolley {
    +trolleyId : String
    +capacityWeightKg : int
  }

  enum PackingHeuristic {
    FF
    FFD
    BFD
  }

  class PickingBatch {
    +batchId : String
    +heuristic : PackingHeuristic
    +utilisationPct : double
  }

  class PickingPlan {
    +planId : String
    +createdAt : DateTime
  }

  enum PathStrategy {
    ASC_SWEEP
    NEAREST_NEIGHBOUR
  }

  class PickPath {
    +pathId : String
    +strategy : PathStrategy
    +totalDistance : int
  }

  class PickStop {
    +seq : int
    +aisle : int
    +bay : int
    +totalQty : int
  }
}

' Relações de Picking
PickingPlan -- PickingBatch : 1 to many
PickingBatch -- PickingTrolley : 1 to 1
PickingBatch -- Allocation : 1 to many
PickPath -- PickStop : 1 to many
PickStop -- Bay : 1 to 1

' ======================= DEVOLUÇÕES & QUARENTENA =======================
package "Devoluções & Quarentena" {
  enum ReturnReason {
    REMORSE
    DAMAGED
    EXPIRED
    CYCLE_COUNT
  }

  class Return {
    +returnId : String
    +sku : String
    +qty : int
    +reason : ReturnReason
    +timestamp : DateTime
    +expiryDate : Date
  }

  enum QAAction {
    RESTOCK
    DISCARD
  }

  class QuarantineInspection {
    +inspectionId : String
    +returnId : String
    +inspectedAt : DateTime
    +action : QAAction
    +qtyRestocked : int
    +qtyDiscarded : int
  }

  class AuditLog {
    +logId : String
    +timestamp : DateTime
    +returnId : String
    +sku : String
    +action : String
    +qty : int
    +details : String
  }

  class QualityOperator {
    +userId : String
    +name : String
  }
}

' Relações de Devoluções
Return -- Station : 1 to 1
QuarantineInspection -- Return : 1 to 1
QuarantineInspection -- Box : zero or one to 1 (on RESTOCK)
AuditLog -- QuarantineInspection : many to many
QualityOperator -- QuarantineInspection : 1 to many

' ======================= PAPÉIS / UTILIZADORES =======================
package "Papéis / Utilizadores" {
  class TrainDriver{
  +trainId : String
  +driverId : int
  +name : String
  }

  class StationMaster {
  +stationMasterId : int
  +name: String
  +stationId : int
  }

  class StationStorageManager {
  +stationStorageManegerId: int
  +stationId : int
  +name : String
  }

  class FreightManager {
  +freightManagerId : int
  +name : String
  }

  class Planner {
  +plannerId : int
  +name : String
  }
}

' Relações de Utilizadores
TrainDriver --> Train : Drive
StationMaster --> Station : Supervision
StationStorageManager --> Station : Operates in
StationStorageManager --> Freight : Manages
FreightManager --> Freight : Manages
Planner --> Train : Schedules


@enduml