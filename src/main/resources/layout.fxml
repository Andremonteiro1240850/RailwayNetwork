<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Sprint1.JavaFX.Controller"
           style="-fx-background-color: linear-gradient(to bottom, #1E293B, #0F172A);">
    <children>
        <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 35;">

            <!-- Title - Clean and Professional with Accent -->
            <VBox alignment="CENTER" spacing="8" style="-fx-padding: 0 0 30 0;">
                <Label text="Railway Terminal Management System"
                       style="-fx-font-size: 28px; -fx-font-weight: 600; -fx-text-fill: linear-gradient(to right, #60A5FA, #3B82F6, #60A5FA); -fx-letter-spacing: 0.5px;"/>
                <Separator prefWidth="450" style="-fx-background-color: linear-gradient(to right, transparent, #3B82F6, transparent); -fx-pref-height: 2;"/>
            </VBox>

            <!-- TabPane - Elegant with Subtle Border -->
            <TabPane prefHeight="650" prefWidth="1000" tabClosingPolicy="UNAVAILABLE"
                     style="-fx-background-color: #0F172A;
                            -fx-border-color: linear-gradient(to right, #3B82F6, #8B5CF6); -fx-border-width: 1.5;
                            -fx-border-radius: 10; -fx-background-radius: 10;">

                <tabs>
                    <!-- Tab 1: Cargo Handling -->
                    <Tab text="Cargo Handling" style="-fx-background-color: #1E293B; -fx-text-base-color: #E2E8F0; -fx-font-size: 13px; -fx-font-weight: 500;">
                        <content>
                            <VBox spacing="30" style="-fx-padding: 45; -fx-background-color: #0F172A;">

                                <VBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="Cargo Handling at Railway Terminal"
                                           style="-fx-font-size: 22px; -fx-font-weight: 600; -fx-text-fill: #F1F5F9;"/>
                                    <Separator prefWidth="550" style="-fx-background-color: linear-gradient(to right, transparent, #3B82F6, transparent); -fx-pref-height: 2;"/>
                                </VBox>

                                <GridPane hgap="25" vgap="25" alignment="CENTER">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50" halignment="CENTER"/>
                                        <ColumnConstraints percentWidth="50" halignment="CENTER"/>
                                    </columnConstraints>

                                    <!-- Row 1 Buttons -->
                                    <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Button text="Wagons Unloading"
                                                onAction="#handleWagonsButton"
                                                prefWidth="400" prefHeight="70"
                                                style="-fx-font-size: 15px; -fx-font-weight: 600; 
                                                       -fx-background-color: #2563EB; 
                                                       -fx-text-fill: #FFFFFF; 
                                                       -fx-background-radius: 8; 
                                                       -fx-cursor: hand;"/>
                                        <Label text="Unload wagons using FEFO/FIFO strategy"
                                               style="-fx-text-fill: #94A3B8; -fx-font-size: 12px; -fx-font-weight: 500;"/>
                                    </VBox>

                                    <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Button text="Order Eligibility"
                                                onAction="#handleOrderEligibilityButton"
                                                prefWidth="400" prefHeight="70"
                                                style="-fx-font-size: 15px; -fx-font-weight: 500; 
                                                       -fx-background-color: linear-gradient(to right, #1E293B, #334155); 
                                                       -fx-text-fill: #CBD5E1; 
                                                       -fx-background-radius: 8; 
                                                       -fx-cursor: hand; 
                                                       -fx-border-color: #475569; -fx-border-width: 1; -fx-border-radius: 8;"/>
                                        <Label text="Coming soon"
                                               style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                                    </VBox>

                                    <!-- Row 2 Buttons -->
                                    <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                        <Button text="Picking Plans" 
                                                onAction="#handlePickingPlansButton"
                                                prefWidth="400" prefHeight="70"
                                                style="-fx-font-size: 15px; -fx-font-weight: 500; 
                                                       -fx-background-color: linear-gradient(to right, #1E293B, #334155); 
                                                       -fx-text-fill: #CBD5E1; 
                                                       -fx-background-radius: 8; 
                                                       -fx-cursor: hand; 
                                                       -fx-border-color: #475569; -fx-border-width: 1; -fx-border-radius: 8;"/>
                                        <Label text="Coming soon"
                                               style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                                    </VBox>

                                    <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <Button text="Pick Path Sequencing" 
                                                onAction="#handlePickPathButton"
                                                prefWidth="400" prefHeight="70"
                                                style="-fx-font-size: 15px; -fx-font-weight: 500; 
                                                       -fx-background-color: linear-gradient(to right, #1E293B, #334155); 
                                                       -fx-text-fill: #CBD5E1; 
                                                       -fx-background-radius: 8; 
                                                       -fx-cursor: hand; 
                                                       -fx-border-color: #475569; -fx-border-width: 1; -fx-border-radius: 8;"/>
                                        <Label text="Coming soon"
                                               style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                                    </VBox>

                                    <!-- Row 3 Buttons -->
                                    <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2" GridPane.halignment="CENTER">
                                        <Button text="Returns and Quarantine" 
                                                onAction="#handleReturnsQuarantineButton"
                                                prefWidth="400" prefHeight="70"
                                                style="-fx-font-size: 15px; -fx-font-weight: 500; 
                                                       -fx-background-color: linear-gradient(to right, #1E293B, #334155); 
                                                       -fx-text-fill: #CBD5E1; 
                                                       -fx-background-radius: 8; 
                                                       -fx-cursor: hand; 
                                                       -fx-border-color: #475569; -fx-border-width: 1; -fx-border-radius: 8;"/>
                                        <Label text="Coming soon"
                                               style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                                    </VBox>

                                </GridPane>

                                <!-- Info Box - Subtle and Clean with Accent -->
                                <HBox spacing="12" alignment="CENTER_LEFT"
                                      style="-fx-background-color: linear-gradient(to right, rgba(59, 130, 246, 0.1), rgba(139, 92, 246, 0.05)); 
                                             -fx-padding: 18; 
                                             -fx-background-radius: 8; 
                                             -fx-border-color: linear-gradient(to right, #3B82F6, #8B5CF6); 
                                             -fx-border-radius: 8; 
                                             -fx-border-width: 1.5;">
                                    <Label text="ℹ" style="-fx-font-size: 20px; -fx-text-fill: #60A5FA;"/>
                                    <VBox spacing="4">
                                        <Label text="Fully Implemented Features"
                                               style="-fx-font-weight: 600; -fx-text-fill: #E2E8F0; -fx-font-size: 13px;"/>
                                        <Label text="Wagons Unloading is fully functional and ready to use"
                                               style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                                    </VBox>
                                </HBox>

                            </VBox>
                        </content>
                    </Tab>

                    <!-- Tab 2: Spatial Queries -->
                    <Tab text="Spatial and Indexed Queries" style="-fx-background-color: #1E293B; -fx-text-base-color: #E2E8F0; -fx-font-size: 13px; -fx-font-weight: 500;">
                        <content>
                            <VBox spacing="30" style="-fx-padding: 45; -fx-background-color: #0F172A;">
                                <VBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="Spatial and Indexed Queries" 
                                           style="-fx-font-size: 22px; -fx-font-weight: 600; -fx-text-fill: #F1F5F9;"/>
                                    <Separator prefWidth="550" style="-fx-background-color: linear-gradient(to right, transparent, #8B5CF6, transparent); -fx-pref-height: 2;"/>
                                </VBox>

                                <GridPane hgap="25" vgap="25" alignment="CENTER">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50" halignment="CENTER"/>
                                        <ColumnConstraints percentWidth="50" halignment="CENTER"/>
                                    </columnConstraints>

                                    <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Button text="Time-Zone Queries" 
                                                onAction="#handleStationLookupButton"
                                                prefWidth="400" prefHeight="70"
                                                style="-fx-font-size: 15px; -fx-font-weight: 500; 
                                                       -fx-background-color: linear-gradient(to right, #1E293B, #334155); 
                                                       -fx-text-fill: #CBD5E1; 
                                                       -fx-background-radius: 8; 
                                                       -fx-cursor: hand; 
                                                       -fx-border-color: #475569; -fx-border-width: 1; -fx-border-radius: 8;"/>
                                        <Label text="Coming soon" 
                                               style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                                    </VBox>

                                    <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Button text="Build 2D-Tree" 
                                                onAction="#handleKDTreeButton"
                                                prefWidth="400" prefHeight="70"
                                                style="-fx-font-size: 15px; -fx-font-weight: 500; 
                                                       -fx-background-color: linear-gradient(to right, #1E293B, #334155); 
                                                       -fx-text-fill: #CBD5E1; 
                                                       -fx-background-radius: 8; 
                                                       -fx-cursor: hand; 
                                                       -fx-border-color: #475569; -fx-border-width: 1; -fx-border-radius: 8;"/>
                                        <Label text="Coming soon" 
                                               style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                                    </VBox>

                                    <!-- Row 2 -->
                                    <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                        <Button text="Geographical Area Search" 
                                                onAction="#handleGeographicalSearchButton"
                                                prefWidth="400" prefHeight="70"
                                                style="-fx-font-size: 15px; -fx-font-weight: 500; 
                                                       -fx-background-color: linear-gradient(to right, #1E293B, #334155); 
                                                       -fx-text-fill: #CBD5E1; 
                                                       -fx-background-radius: 8; 
                                                       -fx-cursor: hand; 
                                                       -fx-border-color: #475569; -fx-border-width: 1; -fx-border-radius: 8;"/>
                                        <Label text="Coming soon" 
                                               style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                                    </VBox>

                                    <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <Button text="Proximity Search" 
                                                onAction="#handleProximitySearchButton"
                                                prefWidth="400" prefHeight="70"
                                                style="-fx-font-size: 15px; -fx-font-weight: 500; 
                                                       -fx-background-color: linear-gradient(to right, #1E293B, #334155); 
                                                       -fx-text-fill: #CBD5E1; 
                                                       -fx-background-radius: 8; 
                                                       -fx-cursor: hand; 
                                                       -fx-border-color: #475569; -fx-border-width: 1; -fx-border-radius: 8;"/>
                                        <Label text="Coming soon" 
                                               style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                                    </VBox>

                                    <!-- Row 3 -->
                                    <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2" GridPane.halignment="CENTER">
                                        <Button text="Radius Search" 
                                                onAction="#handleRadiusSearchButton"
                                                prefWidth="400" prefHeight="70"
                                                style="-fx-font-size: 15px; -fx-font-weight: 500; 
                                                       -fx-background-color: linear-gradient(to right, #1E293B, #334155); 
                                                       -fx-text-fill: #CBD5E1; 
                                                       -fx-background-radius: 8; 
                                                       -fx-cursor: hand; 
                                                       -fx-border-color: #475569; -fx-border-width: 1; -fx-border-radius: 8;"/>
                                        <Label text="Coming soon" 
                                               style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                                    </VBox>
                                </GridPane>

                                <HBox spacing="12" alignment="CENTER_LEFT"
                                      style="-fx-background-color: linear-gradient(to right, rgba(251, 191, 36, 0.1), rgba(245, 158, 11, 0.05)); 
                                             -fx-padding: 18; 
                                             -fx-background-radius: 8; 
                                             -fx-border-color: linear-gradient(to right, #FBBF24, #F59E0B); 
                                             -fx-border-radius: 8; 
                                             -fx-border-width: 1.5;">
                                    <Label text="⚠" style="-fx-font-size: 20px; -fx-text-fill: #FBBF24;"/>
                                    <VBox spacing="4">
                                        <Label text="Under Development" 
                                               style="-fx-font-weight: 600; -fx-text-fill: #E2E8F0; -fx-font-size: 13px;"/>
                                        <Label text="All spatial query features are being implemented" 
                                               style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </content>
                    </Tab>

                    <!-- Tab 3: Railway Network Optimization -->
                    <Tab text="Railway Network Optimization" style="-fx-background-color: #1E293B; -fx-text-base-color: #E2E8F0; -fx-font-size: 13px; -fx-font-weight: 500;">
                        <content>
                            <VBox spacing="35" alignment="CENTER" style="-fx-padding: 60; -fx-background-color: #0F172A;">
                                <VBox spacing="15" alignment="CENTER">
                                    <Label text="Coming Soon" 
                                           style="-fx-font-size: 32px; -fx-font-weight: 600; -fx-text-fill: #F1F5F9;"/>
                                    <Separator prefWidth="400" style="-fx-background-color: #334155; -fx-pref-height: 1;"/>
                                    <Label text="Network optimization features will be available in the next release"
                                           style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;"/>
                                </VBox>
                                
                                <VBox spacing="15" alignment="CENTER" 
                                      style="-fx-background-color: #1E293B; 
                                             -fx-padding: 30; 
                                             -fx-background-radius: 8; 
                                             -fx-border-color: #334155; 
                                             -fx-border-radius: 8; 
                                             -fx-border-width: 1;">
                                    <Label text="Planned Features:" 
                                           style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #E2E8F0;"/>
                                    <VBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 15 0 0 0;">
                                        <Label text="• Route Optimization" 
                                               style="-fx-font-size: 13px; -fx-text-fill: #CBD5E1;"/>
                                        <Label text="• Network Analysis" 
                                               style="-fx-font-size: 13px; -fx-text-fill: #CBD5E1;"/>
                                        <Label text="• Capacity Planning" 
                                               style="-fx-font-size: 13px; -fx-text-fill: #CBD5E1;"/>
                                    </VBox>
                                </VBox>
                            </VBox>
                        </content>
                    </Tab>

                </tabs>
            </TabPane>

            <!-- Footer - Clean and Minimal with Accent -->
            <VBox spacing="8" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                <Separator prefWidth="600" style="-fx-background-color: linear-gradient(to right, transparent, #3B82F6, transparent); -fx-pref-height: 1.5;"/>
                <HBox alignment="CENTER" spacing="20">
                    <Label text="Railway Terminal Management System v2.0" 
                           style="-fx-font-size: 11px; -fx-text-fill: #94A3B8; -fx-font-weight: 500;"/>
                    <Separator orientation="VERTICAL" prefHeight="14" 
                               style="-fx-background-color: #475569;"/>
                    <Label text="© 2024 - All Rights Reserved" 
                           style="-fx-font-size: 11px; -fx-text-fill: #94A3B8; -fx-font-weight: 500;"/>
                </HBox>
            </VBox>

        </VBox>
    </children>
</StackPane>
