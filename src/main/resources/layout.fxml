<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="main.javaFX.Controller"
           style="-fx-background-color: #f5f5f5;">
    <children>
        <VBox spacing="10" alignment="TOP_CENTER" style="-fx-padding: 20;">
            <!-- Title -->
            <HBox alignment="CENTER" style="-fx-padding: 0 0 20 0;">
                <Label text="Railway Terminal Management System"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                </Label>
            </HBox>

            <!-- TabPane -->
            <TabPane prefHeight="550.0" prefWidth="900.0" tabClosingPolicy="UNAVAILABLE"
                     style="-fx-background-color: white; -fx-border-color: #dcdcdc; -fx-border-radius: 5;">
                <tabs>
                    <!-- Tab 1: Cargo Handling -->
                    <Tab text="🚂 Cargo Handling">
                        <content>
                            <VBox spacing="15" style="-fx-padding: 30;">
                                <Label text="Cargo Handling at Railway Terminal"
                                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;">
                                </Label>

                                <Separator/>

                                <GridPane hgap="15" vgap="15">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50"/>
                                        <ColumnConstraints percentWidth="50"/>
                                    </columnConstraints>

                                    <!-- Row 1 -->
                                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Button text="📦 Wagons Unloading ✓"
                                                onAction="#handleWagonsButton"
                                                prefWidth="350" prefHeight="60"
                                                style="-fx-font-size: 14px; -fx-background-color: #2ecc71; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;">
                                        </Button>
                                        <Label text="✓ Unload wagons using FEFO/FIFO strategy"
                                               style="-fx-text-fill: #27ae60; -fx-font-size: 11px; -fx-font-weight: bold;">
                                        </Label>
                                    </VBox>

                                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Button text="✅ Order Eligibility and Allocation 🚧"
                                                onAction="#handleOrderEligibilityButton"
                                                prefWidth="350" prefHeight="60"
                                                style="-fx-font-size: 14px; -fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;">
                                        </Button>
                                        <Label text="🚧 Coming soon - Check order eligibility and allocate"
                                               style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;">
                                        </Label>
                                    </VBox>

                                    <!-- Row 2 -->
                                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                        <Button text="📋 Picking Plans 🚧"
                                                onAction="#handlePickingPlansButton"
                                                prefWidth="350" prefHeight="60"
                                                style="-fx-font-size: 14px; -fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;">
                                        </Button>
                                        <Label text="🚧 Coming soon - Generate and optimize picking plans"
                                               style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;">
                                        </Label>
                                    </VBox>

                                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <Button text="🛤️ Pick Path Sequencing 🚧"
                                                onAction="#handlePickPathButton"
                                                prefWidth="350" prefHeight="60"
                                                style="-fx-font-size: 14px; -fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;">
                                        </Button>
                                        <Label text="🚧 Coming soon - Optimize pick path for efficiency"
                                               style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;">
                                        </Label>
                                    </VBox>

                                    <!-- Row 3 -->
                                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                        <Button text="🔄 Returns and Quarantine 🚧"
                                                onAction="#handleReturnsQuarantineButton"
                                                prefWidth="350" prefHeight="60"
                                                style="-fx-font-size: 14px; -fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;">
                                        </Button>
                                        <Label text="🚧 Coming soon - Manage returns and quarantine items"
                                               style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;">
                                        </Label>
                                    </VBox>
                                </GridPane>

                                <!-- Info Box -->
                                <HBox spacing="10" alignment="CENTER_LEFT"
                                      style="-fx-background-color: #e8f5e9; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #81c784; -fx-border-radius: 5; -fx-border-width: 2;">
                                    <Label text="ℹ️" style="-fx-font-size: 20px;"/>
                                    <VBox spacing="5">
                                        <Label text="Fully Implemented Features"
                                               style="-fx-font-weight: bold; -fx-text-fill: #2e7d32;">
                                        </Label>
                                        <Label text="✓ Wagons Unloading is fully functional with complete JavaFX interface"
                                               style="-fx-text-fill: #2e7d32; -fx-font-size: 12px;">
                                        </Label>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </content>
                    </Tab>

                    <!-- Tab 2: Spatial Queries -->
                    <Tab text="🗺️ Spatial and Indexed Queries">
                        <content>
                            <VBox spacing="15" style="-fx-padding: 30;">
                                <Label text="Spatial and Indexed Queries"
                                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;">
                                </Label>

                                <Separator/>

                                <GridPane hgap="15" vgap="15">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50"/>
                                        <ColumnConstraints percentWidth="50"/>
                                    </columnConstraints>

                                    <!-- Row 1 -->
                                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Button text="🕐 Time-Zone Index and Windowed Queries 🚧"
                                                onAction="#handleStationLookupButton"
                                                prefWidth="350" prefHeight="60"
                                                style="-fx-font-size: 14px; -fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;">
                                        </Button>
                                        <Label text="🚧 Coming soon - Query stations by time-zone"
                                               style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;">
                                        </Label>
                                    </VBox>

                                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Button text="🌳 Build 2D-Tree (Lat/Long) 🚧"
                                                onAction="#handleKDTreeButton"
                                                prefWidth="350" prefHeight="60"
                                                style="-fx-font-size: 14px; -fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;">
                                        </Button>
                                        <Label text="🚧 Coming soon - Build balanced KD-Tree"
                                               style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;">
                                        </Label>
                                    </VBox>

                                    <!-- Row 2 -->
                                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                        <Button text="📍 Geographical Area Search 🚧"
                                                onAction="#handleGeographicalSearchButton"
                                                prefWidth="350" prefHeight="60"
                                                style="-fx-font-size: 14px; -fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;">
                                        </Button>
                                        <Label text="🚧 Coming soon - Search within geographical boundaries"
                                               style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;">
                                        </Label>
                                    </VBox>

                                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <Button text="🎯 Proximity Search (Nearest-N) 🚧"
                                                onAction="#handleProximitySearchButton"
                                                prefWidth="350" prefHeight="60"
                                                style="-fx-font-size: 14px; -fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;">
                                        </Button>
                                        <Label text="🚧 Coming soon - Find nearest stations with filters"
                                               style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;">
                                        </Label>
                                    </VBox>

                                    <!-- Row 3 -->
                                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                        <Button text="⭕ Radius Search and Density 🚧"
                                                onAction="#handleRadiusSearchButton"
                                                prefWidth="350" prefHeight="60"
                                                style="-fx-font-size: 14px; -fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;">
                                        </Button>
                                        <Label text="🚧 Coming soon - Search within radius and analyze density"
                                               style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;">
                                        </Label>
                                    </VBox>
                                </GridPane>

                                <!-- Info Box -->
                                <HBox spacing="10" alignment="CENTER_LEFT"
                                      style="-fx-background-color: #fff3e0; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #ffb74d; -fx-border-radius: 5; -fx-border-width: 2;">
                                    <Label text="⚠️" style="-fx-font-size: 20px;"/>
                                    <VBox spacing="5">
                                        <Label text="Under Development"
                                               style="-fx-font-weight: bold; -fx-text-fill: #e65100;">
                                        </Label>
                                        <Label text="All spatial query features are currently being implemented"
                                               style="-fx-text-fill: #e65100; -fx-font-size: 12px;">
                                        </Label>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </content>
                    </Tab>

                    <!-- Tab 3: Network Optimization -->
                    <Tab text="🚄 Railway Network Optimization">
                        <content>
                            <VBox spacing="15" alignment="CENTER" style="-fx-padding: 50;">
                                <Label text="🚧 Coming Soon"
                                       style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #95a5a6;">
                                </Label>
                                <Label text="Network optimization features will be available in the next release"
                                       style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;">
                                </Label>

                                <VBox spacing="10" alignment="CENTER" style="-fx-padding: 30 0 0 0;">
                                    <Label text="Planned Features:"
                                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;">
                                    </Label>
                                    <Label text="• Route Optimization"
                                           style="-fx-font-size: 12px; -fx-text-fill: #95a5a6;">
                                    </Label>
                                    <Label text="• Network Analysis"
                                           style="-fx-font-size: 12px; -fx-text-fill: #95a5a6;">
                                    </Label>
                                    <Label text="• Capacity Planning"
                                           style="-fx-font-size: 12px; -fx-text-fill: #95a5a6;">
                                    </Label>
                                </VBox>
                            </VBox>
                        </content>
                    </Tab>
                </tabs>
            </TabPane>

            <!-- Footer -->
            <HBox alignment="CENTER" spacing="20" style="-fx-padding: 15 0 0 0;">
                <Label text="Railway Terminal Management System v2.0"
                       style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;">
                </Label>
                <Separator orientation="VERTICAL" prefHeight="15"/>
                <Label text="© 2024 - All Rights Reserved"
                       style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;">
                </Label>
            </HBox>
        </VBox>
    </children>
</StackPane>