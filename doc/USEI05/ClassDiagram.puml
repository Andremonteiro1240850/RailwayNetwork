@startuml USEI05_ClassDiagram
skinparam monochrome true
skinparam style strictuml

package "UI" {
    class QualityOperatorUI {
        - controller : QualityOperatorController
        - scanner : Scanner
        - dateFormatter : DateTimeFormatter
        + QualityOperatorUI(controller: QualityOperatorController)
        + showLogin() : boolean
        + showMainMenu() : void
        + showDashboard() : void
        - viewQuarantineQueue() : void
        - processSingleInspection() : void
        - processAllInspections() : void
        - viewProcessedInspections() : void
        - viewAuditLog() : void
        - reloadReturnsFromCSV() : void
        - renderInspectionsTable() : void
        - renderAuditLogTable() : void
    }
}

package "Controller" {
    class QualityOperatorController {
        - inspectionController : InspectionController
        - quarantineItems : List<Return>
        + QualityOperatorController()
        + QualityOperatorController(warehouseManager: WarehouseManager)
        + loadReturnsFromCSV() : LoadResult
        + loadReturnsFromCSV(showDetails: boolean) : LoadResult
        + getQuarantineItems() : List<Return>
        + processSingleInspection() : ProcessingResult
        + processAllInspections() : ProcessingSummary
        + getProcessedInspections() : List<QuarantineInspection>
        + getAuditLogs() : List<String>
        - mapReturnReason(csvReason: String) : String
        - determineProcessingReason(item: Return) : String
        - determineActionFromReason(reason: String) : String
        - sortQuarantineQueue() : void
    }
    
    class InspectionController {
        - quarantineInspections : List<QuarantineInspection>
        - warehouseManager : WarehouseManager
        - AUDIT_FORMATTER : DateTimeFormatter
        + InspectionController()
        + InspectionController(warehouseManager: WarehouseManager)
        + processQuarantine(sku: String, quantity: int, returnReason: String, expiryDate: LocalDate) : String
        + processQuarantine(sku: String, quantity: int, returnReason: String, expiryDate: LocalDate, qtyRestocked: Integer, qtyDiscarded: Integer) : String
        + getInspectionsBySku(sku: String) : List<QuarantineInspection>
        + getAuditLogs() : List<String>
        - createQuarantineInspection() : QuarantineInspection
        - determineAction(returnReason: String) : QAAction
        - processRestock(inspection: QuarantineInspection, sku: String, quantity: int, expiryDate: LocalDate) : void
        - processDiscard(inspection: QuarantineInspection, sku: String, quantity: int) : void
        - createAuditLog(inspection: QuarantineInspection, sku: String, quantity: int, action: QAAction, returnReason: String, qtyRestocked: Integer, qtyDiscarded: Integer) : void
        - generateId(prefix: String) : String
    }
}

package "Domain" {
    class QualityOperator {
        - quarantineItems : List<Return>
        - inspectionController : InspectionController
        - scanner : Scanner
        - dateFormatter : DateTimeFormatter
        + QualityOperator()
        + start() : void
        - showMainMenu() : void
        - viewQuarantineQueue() : void
        - processNextInspection() : void
        - viewProcessedInspections() : void
        - viewAuditLog() : void
        - sortQuarantineQueue() : void
        - logout() : void
    }
    
    class QuarantineInspection {
        - inspectionId : String
        - inspectedAt : LocalDateTime
        - returnId : String
        - action : QAAction
        + QuarantineInspection()
        + QuarantineInspection(inspectionId: String, returnId: String, inspectedAt: LocalDateTime, action: QAAction)
        + getInspectionId() : String
        + getInspectedAt() : LocalDateTime
        + getReturnId() : String
        + getAction() : QAAction
        + setInspectionId(inspectionId: String) : void
        + setInspectedAt(inspectedAt: LocalDateTime) : void
        + setReturnId(returnId: String) : void
        + setAction(action: QAAction) : void
        + toString() : String
    }
    
    class Return {
        - returnId : String
        - sku : String
        - qty : int
        - reason : String
        - timestamp : LocalDateTime
        - expiryDate : LocalDate
        + Return(returnId: String, sku: String, qty: int, reason: String, timestamp: LocalDateTime, expiryDate: LocalDate)
        + getReturnId() : String
        + getSku() : String
        + getQty() : int
        + getReason() : String
        + getTimestamp() : LocalDateTime
        + getExpiryDate() : LocalDate
        + setQty(qty: int) : void
        + setReason(reason: String) : void
        + setExpiryDate(expiryDate: LocalDate) : void
        + toString() : String
    }
    
    class AuditLog {
        + {static} readAll() : List<String>
        + {static} clearAll() : void
        + {static} appendLine(line: String) : void
    }
    
    class WarehouseManager {
        + insertReturnedBox(boxId: String, sku: String, qty: int, expiryDate: LocalDate, receivedAt: LocalDateTime) : void
    }
    
    enum QAAction {
        RESTOCK
        DISCARD
    }
}

' Relationships
QualityOperatorUI "1" --> "1" QualityOperatorController
QualityOperatorController "1" --> "1" InspectionController
QualityOperatorController ..> Return
QualityOperatorController ..> WarehouseManager
InspectionController "1" *-- "*" QuarantineInspection
InspectionController ..> WarehouseManager
InspectionController ..> QAAction
InspectionController ..> AuditLog
QuarantineInspection "1" --> "1" QAAction
QualityOperator "1" --> "1" InspectionController
QualityOperator ..> Return

@enduml
